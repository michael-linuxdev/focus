{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Geführter Ablauf. defenses: Verteidigungen in Reihenfolge, danach afterDefenses. steps: Schritte mit Hinweis und Abschlussbedingung; unlocks schaltet Teile der Oberfläche frei",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "defenses",
    "afterDefenses",
    "steps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "defenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wave",
          "holdMilliUntilTower",
          "unlosable",
          "victoryGold"
        ],
        "properties": {
          "wave": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "holdMilliUntilTower": {
            "type": "integer",
            "minimum": 0
          },
          "unlosable": {
            "type": "boolean"
          },
          "victoryGold": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "afterDefenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave",
        "holdMilliUntilTower",
        "unlosable",
        "victoryGold"
      ],
      "properties": {
        "wave": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "holdMilliUntilTower": {
          "type": "integer",
          "minimum": 0
        },
        "unlosable": {
          "type": "boolean"
        },
        "victoryGold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hint",
          "done",
          "freeSkip",
          "autoDefense",
          "unlocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "hint": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "slot",
                  "tower"
                ],
                "properties": {
                  "type": {
                    "const": "slot"
                  },
                  "slot": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "tower": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "plot",
                  "building"
                ],
                "properties": {
                  "type": {
                    "const": "plot"
                  },
                  "plot": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "building": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "keep"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "button"
                ],
                "properties": {
                  "type": {
                    "const": "button"
                  },
                  "button": {
                    "enum": [
                      "defend",
                      "hero",
                      "attack"
                    ]
                  }
                }
              }
            ]
          },
          "done": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "defensesWon"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "towerCount"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "level"
                ],
                "properties": {
                  "type": {
                    "const": "towerLevel"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "tower"
                ],
                "properties": {
                  "type": {
                    "const": "towerOfType"
                  },
                  "tower": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "building"
                ],
                "properties": {
                  "type": {
                    "const": "buildingStarted"
                  },
                  "building": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "building"
                ],
                "properties": {
                  "type": {
                    "const": "buildingDone"
                  },
                  "building": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "level"
                ],
                "properties": {
                  "type": {
                    "const": "keepLevel"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "roadChosen"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "heroAssigned"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "unit",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "troopsTrained"
                  },
                  "unit": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "attacksDone"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "never"
                  }
                }
              }
            ]
          },
          "freeSkip": {
            "type": "boolean"
          },
          "autoDefense": {
            "type": "boolean"
          },
          "unlocks": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}