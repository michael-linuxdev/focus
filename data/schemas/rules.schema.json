{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schlacht- und Beuteregeln. lootMaxPermille ist die feste Verlustgrenze: höchster Anteil der ungeschützten Vorräte. depthLootPermille: Anteil davon je Durchbruchstiefe 0 bis 3. Schild: newPlayerShieldHours für neue Spieler, defeatShieldHours nach einer Niederlage. Nachtangriff: frühestens nightRaidAfterHours nach der Ankündigung. cityLossMinDepth: Die eigene Stadt verliert erst ab dieser Durchbruchstiefe Vorräte. freeNightRaids: So viele erste Nachtangriffe kosten nichts. volley: Pfeilhagel des Verteidigers (Schaden im Umkreis um den angetippten Punkt). starGold: Bonusgold je Sternezahl 0 bis 3 nach einer Verteidigung",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "gateMilli",
    "marketPermille",
    "attackMaxTicks",
    "attackSpawnIntervalTicks",
    "attackWaves",
    "lootMaxPermille",
    "depthLootPermille",
    "maxReplays",
    "productionIntervalSeconds",
    "cityGateHp",
    "newPlayerShieldHours",
    "defeatShieldHours",
    "nightRaidAfterHours",
    "nightRaidWave",
    "cityLossMinDepth",
    "freeNightRaids",
    "volley",
    "starGold",
    "defenseLossOnlyWhenBreached",
    "campRegenHours",
    "revengeAfterHours"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "gateMilli": {
      "type": "integer",
      "minimum": 1
    },
    "marketPermille": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "attackMaxTicks": {
      "type": "integer",
      "minimum": 1
    },
    "attackSpawnIntervalTicks": {
      "type": "integer",
      "minimum": 1
    },
    "attackWaves": {
      "type": "integer",
      "minimum": 1
    },
    "lootMaxPermille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "depthLootPermille": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "maxReplays": {
      "type": "integer",
      "minimum": 1
    },
    "productionIntervalSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "cityGateHp": {
      "type": "integer",
      "minimum": 0
    },
    "newPlayerShieldHours": {
      "type": "integer",
      "minimum": 1
    },
    "defeatShieldHours": {
      "type": "integer",
      "minimum": 1
    },
    "nightRaidAfterHours": {
      "type": "integer",
      "minimum": 1
    },
    "nightRaidWave": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "cityLossMinDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "freeNightRaids": {
      "type": "integer",
      "minimum": 0
    },
    "volley": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage",
        "radiusMilli",
        "cooldownTicks"
      ],
      "properties": {
        "damage": {
          "type": "integer",
          "minimum": 1
        },
        "radiusMilli": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "starGold": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "defenseLossOnlyWhenBreached": {
      "type": "boolean"
    },
    "campRegenHours": {
      "type": "integer",
      "minimum": 1
    },
    "revengeAfterHours": {
      "type": "integer",
      "minimum": 1
    }
  }
}
