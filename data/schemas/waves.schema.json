{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wellen (Zeiten in Ticks). waves: fest aufgeschriebene Wellen des geführten Ablaufs. scaling: Regeln für die berechneten Wellen danach",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "waves",
    "scaling"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "groups"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "count",
                "startTick",
                "intervalTicks",
                "jitterTicks"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "startTick": {
                  "type": "integer",
                  "minimum": 0
                },
                "intervalTicks": {
                  "type": "integer",
                  "minimum": 0
                },
                "jitterTicks": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wavesPerKeepLevel",
        "budgetBase",
        "budgetGrowthPermille",
        "hpGrowthPermille",
        "units",
        "firstTick",
        "windowTicks",
        "burstTicks",
        "minIntervalTicks",
        "maxIntervalTicks",
        "jitterTicks",
        "boss",
        "victoryGoldBase",
        "victoryGoldGrowthPermille",
        "repeatGoldPermille",
        "parSeconds",
        "raidFromWave",
        "raidStrengthPermille",
        "hpBasePermille",
        "raidHpBasePermille",
        "raidHpGrowthPermille"
      ],
      "properties": {
        "wavesPerKeepLevel": {
          "type": "integer",
          "minimum": 2
        },
        "budgetBase": {
          "type": "integer",
          "minimum": 1
        },
        "budgetGrowthPermille": {
          "type": "integer",
          "minimum": 1000
        },
        "hpGrowthPermille": {
          "type": "integer",
          "minimum": 1000
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "fromWave",
              "sharePermille"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "fromWave": {
                "type": "integer",
                "minimum": 0
              },
              "sharePermille": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "firstTick": {
          "type": "integer",
          "minimum": 0
        },
        "windowTicks": {
          "type": "integer",
          "minimum": 1
        },
        "burstTicks": {
          "type": "integer",
          "minimum": 1
        },
        "minIntervalTicks": {
          "type": "integer",
          "minimum": 1
        },
        "maxIntervalTicks": {
          "type": "integer",
          "minimum": 1
        },
        "jitterTicks": {
          "type": "integer",
          "minimum": 0
        },
        "boss": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "startTick",
            "extraParSeconds"
          ],
          "properties": {
            "unit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "startTick": {
              "type": "integer",
              "minimum": 0
            },
            "extraParSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "victoryGoldBase": {
          "type": "integer",
          "minimum": 0
        },
        "victoryGoldGrowthPermille": {
          "type": "integer",
          "minimum": 1000
        },
        "repeatGoldPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "parSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "raidFromWave": {
          "type": "integer",
          "minimum": 1
        },
        "raidStrengthPermille": {
          "type": "integer",
          "minimum": 1
        },
        "hpBasePermille": {
          "type": "integer",
          "minimum": 1
        },
        "raidHpBasePermille": {
          "type": "integer",
          "minimum": 1
        },
        "raidHpGrowthPermille": {
          "type": "integer",
          "minimum": 1000
        }
      }
    }
  }
}
