{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stadt: Startvorräte, Mauerabschnitte, Turm-Bauplätze an der Straße, Bauplätze abseits, Burgfried-Stufen mit wählbaren Straßenverläufen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "start",
    "sections",
    "towerSlots",
    "plots",
    "keepLevels"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "keepHp"
      ],
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gold",
            "wood",
            "stone"
          ],
          "properties": {
            "gold": {
              "type": "integer",
              "minimum": 0
            },
            "wood": {
              "type": "integer",
              "minimum": 0
            },
            "stone": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "keepHp": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "towerSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "x",
          "y",
          "keepLevel",
          "section"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "keepLevel": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "plots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "keepLevels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "cost",
          "buildSeconds",
          "roads"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "buildSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "roads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    }
  }
}