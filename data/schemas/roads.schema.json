{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Straßenverläufe (Kachelkoordinaten, nur achsenparallele Abschnitte)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "grid", "roads"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows"],
      "properties": { "cols": { "type": "integer", "minimum": 1 }, "rows": { "type": "integer", "minimum": 1 } }
    },
    "roads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "waypoints"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    }
  }
}
