{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulierte Allianz aus Bots (Platzhalter, keine echten Spieler). Nach einer Bitte um Hilfe hilft alle helpIntervalSeconds ein Mitglied und verkürzt den Bau um helpReduceSeconds, höchstens maxHelps-mal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "placeholder",
    "id",
    "members",
    "joinReward",
    "helpIntervalSeconds",
    "helpReduceSeconds",
    "maxHelps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "placeholder": {
      "const": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "joinReward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold",
        "wood",
        "stone"
      ],
      "properties": {
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "wood": {
          "type": "integer",
          "minimum": 0
        },
        "stone": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "helpIntervalSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "helpReduceSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "maxHelps": {
      "type": "integer",
      "minimum": 1
    }
  }
}