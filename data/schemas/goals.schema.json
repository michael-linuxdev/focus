{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tagesziele: Zähler des Tages erreicht count, dann einmal Belohnung. Zähler beginnen jeden Tag bei null",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "goals"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "counter",
          "count",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "counter": {
            "enum": [
              "defenses",
              "attacks",
              "built",
              "trained"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}