{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ziele. goals: Tagesziele (die ersten dailyFixed gelten jeden Tag, dazu dailyRotating wechselnde); Zähler beginnen jeden Tag bei null. weekly: ein Wochenziel je Woche, reihum. login: Belohnung für die Rückkehr, einmal je Tag, reihum. rewardPermilleByKeepLevel: Faktor auf alle Belohnungen je Burgfried-Stufe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "goals",
    "dailyFixed",
    "dailyRotating",
    "rewardPermilleByKeepLevel",
    "weekly",
    "login"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "counter",
          "count",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "counter": {
            "enum": [
              "defenses",
              "attacks",
              "built",
              "trained",
              "stars",
              "towers"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "dailyFixed": {
      "type": "integer",
      "minimum": 0
    },
    "dailyRotating": {
      "type": "integer",
      "minimum": 0
    },
    "rewardPermilleByKeepLevel": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "weekly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "counter",
          "count",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "counter": {
            "enum": [
              "defenses",
              "attacks",
              "built",
              "trained",
              "stars",
              "towers"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "login": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gold",
          "wood",
          "stone"
        ],
        "properties": {
          "gold": {
            "type": "integer",
            "minimum": 0
          },
          "wood": {
            "type": "integer",
            "minimum": 0
          },
          "stone": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
