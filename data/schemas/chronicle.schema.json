{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chronik: Kapitel des ersten Spielmonats in fester Reihenfolge. Ein Kapitel ist erfüllt, wenn sein Ziel erreicht ist; die Belohnung wächst mit der Burgfried-Stufe wie bei den Tageszielen. Mit dem letzten Kapitel ist der Spieler gekrönt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "chapters"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "goal": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "level"
                ],
                "properties": {
                  "type": {
                    "const": "keepLevel"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "wavesCleared"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "count"
                ],
                "properties": {
                  "type": {
                    "const": "citiesTaken"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "building",
                  "level"
                ],
                "properties": {
                  "type": {
                    "const": "buildingLevel"
                  },
                  "building": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "city"
                ],
                "properties": {
                  "type": {
                    "const": "cityTaken"
                  },
                  "city": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  }
                }
              }
            ]
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
