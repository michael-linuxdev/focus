{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ausbildbare Truppen des Spielers (Kosten und Zeiten je Einheit, batch: Stückzahl je Ausbildungsauftrag)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "troops"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "troops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "cost",
          "trainSeconds",
          "healSeconds",
          "batch"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "trainSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "healSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "batch": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}