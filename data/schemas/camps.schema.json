{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Angriffsziele auf der Weltkarte: Räuberlager (camp) und computergesteuerte Nachbarstädte (city). Attrappe: feste Verteidigung, Vorräte wachsen nach. ring: ab dieser Burgfried-Stufe des Spielers angreifbar. shielded: durch einen Schild geschützt, nicht angreifbar. map: Lage auf der Karte in Prozent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "camps"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "camps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "shielded",
          "map",
          "roadId",
          "keepLevel",
          "gateHp",
          "towers",
          "stock",
          "protected",
          "ring"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "camp",
              "city"
            ]
          },
          "shielded": {
            "type": "boolean"
          },
          "map": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "roadId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "keepLevel": {
            "type": "integer",
            "minimum": 1
          },
          "gateHp": {
            "type": "integer",
            "minimum": 0
          },
          "towers": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slot",
                "def",
                "level"
              ],
              "properties": {
                "slot": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "def": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "stock": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "protected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gold",
              "wood",
              "stone"
            ],
            "properties": {
              "gold": {
                "type": "integer",
                "minimum": 0
              },
              "wood": {
                "type": "integer",
                "minimum": 0
              },
              "stone": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "ring": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
