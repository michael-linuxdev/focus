{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Die Heldin: Abschnittsbonus in der Verteidigung, Gefolge beim Beitritt, Fähigkeiten im Angriff. rally: Kampfruf in der Verteidigung, alle Türme schießen für die Dauer doppelt so schnell",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "id",
    "joinsAtKeepLevel",
    "sectionBonusPermille",
    "retinue",
    "abilities",
    "rally"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "joinsAtKeepLevel": {
      "type": "integer",
      "minimum": 1
    },
    "sectionBonusPermille": {
      "type": "integer",
      "minimum": 0
    },
    "retinue": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "count"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "durationTicks",
          "cooldownTicks",
          "damageTakenPermille"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "shield",
              "disableTower"
            ]
          },
          "durationTicks": {
            "type": "integer",
            "minimum": 1
          },
          "cooldownTicks": {
            "type": "integer",
            "minimum": 1
          },
          "damageTakenPermille": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rally": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "durationTicks",
        "cooldownTicks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}