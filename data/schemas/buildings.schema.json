{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gebäude abseits der Straße (je eines pro Stadt), eine Zeile je Ausbaustufe. cost: Bau (Stufe 1) bzw. Ausbau auf diese Stufe, producePerHour: Ertrag je Stunde, protect: geschützter Grundstock, capacity: zusätzlicher Lagerplatz, healTimePermille: Faktor auf Lazarettzeiten, keepLevel: nötige Burgfried-Stufe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "buildings"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cost",
                "buildSeconds",
                "producePerHour",
                "protect",
                "healTimePermille",
                "capacity",
                "keepLevel",
                "armyCap",
                "troopHpPermille"
              ],
              "properties": {
                "cost": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gold",
                    "wood",
                    "stone"
                  ],
                  "properties": {
                    "gold": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "wood": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stone": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "buildSeconds": {
                  "type": "integer",
                  "minimum": 0
                },
                "producePerHour": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gold",
                    "wood",
                    "stone"
                  ],
                  "properties": {
                    "gold": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "wood": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stone": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "protect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gold",
                    "wood",
                    "stone"
                  ],
                  "properties": {
                    "gold": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "wood": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stone": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "healTimePermille": {
                  "type": "integer",
                  "minimum": 1
                },
                "capacity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gold",
                    "wood",
                    "stone"
                  ],
                  "properties": {
                    "gold": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "wood": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stone": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "keepLevel": {
                  "type": "integer",
                  "minimum": 1
                },
                "armyCap": {
                  "type": "integer",
                  "minimum": 0
                },
                "troopHpPermille": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
