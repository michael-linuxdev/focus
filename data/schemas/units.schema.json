{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Einheiten (Geschwindigkeit in Tausendstel-Kacheln pro Tick)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "preliminary", "units"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "preliminary": { "type": "boolean" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hp", "speedMilliPerTick"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }, "hp": { "type": "integer", "minimum": 1 }, "speedMilliPerTick": { "type": "integer", "minimum": 1 } }
      }
    }
  }
}
