{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Einheiten (Geschwindigkeit in Tausendstel-Kacheln pro Tick, bounty in Gold, keepDamage in Burgfried-Leben)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "units"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hp",
          "speedMilliPerTick",
          "bounty",
          "keepDamage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "speedMilliPerTick": {
            "type": "integer",
            "minimum": 1
          },
          "bounty": {
            "type": "integer",
            "minimum": 0
          },
          "keepDamage": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}