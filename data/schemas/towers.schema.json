{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Türme: eine Zeile je Stufe (cost in Gold für Bau bzw. Ausbau auf diese Stufe, Reichweite in Tausendstel-Kacheln, Schussfolge in Ticks). splashMilli > 0: Flächenschaden um das Ziel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "towers"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keepLevel",
          "splashMilli",
          "levels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "keepLevel": {
            "type": "integer",
            "minimum": 1
          },
          "splashMilli": {
            "type": "integer",
            "minimum": 0
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cost",
                "damage",
                "rangeMilli",
                "cooldownTicks"
              ],
              "properties": {
                "cost": {
                  "type": "integer",
                  "minimum": 0
                },
                "damage": {
                  "type": "integer",
                  "minimum": 1
                },
                "rangeMilli": {
                  "type": "integer",
                  "minimum": 1
                },
                "cooldownTicks": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}