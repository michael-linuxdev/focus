{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Türme, eine Zeile je Stufe. kind shot: schießt auf ein Ziel (splashMilli > 0: Flächenschaden). kind slow: bremst alle in Reichweite auf slowPermille und trifft sie ohne Rüstungsabzug. kind militia: stellt Miliz mit militiaHp auf die Straße, die Angreifer aufhält und im Takt cooldownTicks zuschlägt. keepLevel je Stufe: nötige Burgfried-Stufe für den Ausbau",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preliminary",
    "towers"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "preliminary": {
      "type": "boolean"
    },
    "towers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "keepLevel",
          "splashMilli",
          "levels",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "keepLevel": {
            "type": "integer",
            "minimum": 1
          },
          "splashMilli": {
            "type": "integer",
            "minimum": 0
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cost",
                "damage",
                "rangeMilli",
                "cooldownTicks",
                "slowPermille",
                "militiaHp",
                "militiaRespawnTicks",
                "keepLevel"
              ],
              "properties": {
                "cost": {
                  "type": "integer",
                  "minimum": 0
                },
                "damage": {
                  "type": "integer",
                  "minimum": 1
                },
                "rangeMilli": {
                  "type": "integer",
                  "minimum": 1
                },
                "cooldownTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "slowPermille": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "militiaHp": {
                  "type": "integer",
                  "minimum": 0
                },
                "militiaRespawnTicks": {
                  "type": "integer",
                  "minimum": 0
                },
                "keepLevel": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "kind": {
            "enum": [
              "shot",
              "slow",
              "militia"
            ]
          }
        }
      }
    }
  }
}
